# इस फ़ाइल को .env.local नाम से कॉपी करें और भरें

# एडमिन पैनल का password (ज़रूर बदलें! लंबा रखें)
ADMIN_PASSWORD=
# लंबा random text (login cookie को सुरक्षित रखता है)
ADMIN_SESSION_SECRET=

# वेबसाइट का पूरा पता (https:// के साथ) — WhatsApp पर लिंक की फ़ोटो/नाम इसी से दिखते हैं
SITE_URL=https://yourname.duckdns.org

# Telegram बैकअप + नए दान की सूचना (@BotFather से token, chat id का तरीक़ा DEPLOY-ORACLE.md में)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# सिर्फ़ तब 1 रखें जब साइट https के बिना चल रही हो
ALLOW_INSECURE_COOKIE=
